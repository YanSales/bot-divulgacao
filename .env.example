# ============================================
# Bot de Divulgação - Environment Variables
# Copie para .env e preencha com seus valores
# ============================================

# ============================================
# AMBIENTE
# ============================================
ENVIRONMENT=development  # development, staging, production
DEBUG=True
SECRET_KEY=sua_chave_secreta_minimo_32_caracteres_aqui
API_KEY=chave_para_acesso_externo_a_api

# ============================================
# DATABASE
# ============================================
# Desenvolvimento (SQLite)
DATABASE_URL=sqlite:///./bot_marketing.db

# Produção (PostgreSQL)
# DATABASE_URL=postgresql://user:password@localhost:5432/bot_marketing

# ============================================
# REDIS (Cache & Queue)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# INSTAGRAM
# ============================================
INSTAGRAM_USERNAME=seu_usuario_instagram
INSTAGRAM_PASSWORD=sua_senha_instagram
INSTAGRAM_ACCESS_TOKEN=seu_token_de_longa_duracao
INSTAGRAM_USER_ID=seu_instagram_user_id

# Nota: Para obter token de longa duração:
# 1. Acesse https://developers.facebook.com/apps
# 2. Crie um app e vincule sua conta Instagram Business
# 3. Use Graph API Explorer para gerar token

# ============================================
# FACEBOOK
# ============================================
FACEBOOK_APP_ID=seu_app_id
FACEBOOK_APP_SECRET=seu_app_secret
FACEBOOK_PAGE_ID=id_da_sua_pagina
FACEBOOK_USER_ACCESS_TOKEN=token_do_usuario

# ============================================
# TWITTER/X
# ============================================
TWITTER_API_KEY=sua_api_key
TWITTER_API_SECRET=sua_api_secret
TWITTER_ACCESS_TOKEN=seu_access_token
TWITTER_ACCESS_SECRET=seu_access_secret
TWITTER_BEARER_TOKEN=seu_bearer_token

# ============================================
# TIKTOK (Opcional - API limitada)
# ============================================
TIKTOK_CLIENT_KEY=sua_client_key
TIKTOK_CLIENT_SECRET=sua_client_secret
TIKTOK_ACCESS_TOKEN=seu_access_token
TIKTOK_ENABLED=False  # Desabilitado por padrão

# ============================================
# YOUTUBE
# ============================================
YOUTUBE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=seu_client_secret
YOUTUBE_REFRESH_TOKEN=seu_refresh_token

# Para obter credentials:
# 1. Acesse https://console.cloud.google.com
# 2. Crie projeto e habilite YouTube Data API v3
# 3. Crie credenciais OAuth 2.0

# ============================================
# WHATSAPP (Twilio)
# ============================================
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_ENABLED=True

# ============================================
# AZURE STORAGE
# ============================================
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_CONTAINER=bot-media

# Para desenvolvimento local, pode usar storage local:
# LOCAL_STORAGE_PATH=./uploads

# ============================================
# LANDING PAGE INTEGRATION
# ============================================
LP_WEBHOOK_SECRET=chave_secreta_compartilhada_com_lp
LP_API_URL=https://sua-landing-page.com/api
LP_API_KEY=chave_para_enviar_dados_para_lp

# ============================================
# RATE LIMITS
# ============================================
MAX_POSTS_PER_HOUR=10
MAX_COMMENTS_PER_HOUR=30
MAX_MESSAGES_PER_DAY=100
MAX_API_REQUESTS_PER_HOUR=200

# ============================================
# CONFIGURAÇÕES DO BOT
# ============================================
POSTING_TIMES=07:30,12:30,17:30
OPERATION_MODE=semi-automatic  # automatic, semi-automatic
AUTO_ANALYSIS_ENABLED=True

# ============================================
# MONITORAMENTO & LOGS
# ============================================
# Application Insights (Azure)
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=...

# Sentry (Error Tracking)
SENTRY_DSN=https://...@sentry.io/...

# Log Level
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============================================
# SEGURANÇA
# ============================================
# Chave para criptografia de tokens (gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=sua_chave_fernet_aqui

# CORS (API)
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ============================================
# SMTP (Email Notifications - Opcional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app
EMAIL_FROM=bot@seudominio.com

# ============================================
# WEBHOOK URLS (configurar nas plataformas)
# ============================================
# Configure estas URLs nas plataformas:
# Instagram: https://seu-dominio.com/webhooks/instagram
# Facebook: https://seu-dominio.com/webhooks/facebook
# WhatsApp: https://seu-dominio.com/webhooks/whatsapp